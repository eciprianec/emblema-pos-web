# Configuración del Microservicio e-CF
PORT=3001
NODE_ENV=development

# Certificado Digital DGII
CERTIFICATE_PATH=./certs/certificate.p12
CERTIFICATE_PASSWORD=your_certificate_password

# Configuración DGII
RNC_EMISOR=101010101
DGII_ENVIRONMENT=DEV

# Información del Emisor
EMISOR_RAZON_SOCIAL=Mi Empresa SRL
EMISOR_NOMBRE_COMERCIAL=Mi Empresa
EMISOR_DIRECCION=Calle Principal #1, Santo Domingo
EMISOR_MUNICIPIO=010100
EMISOR_PROVINCIA=010000
EMISOR_TELEFONO=809-555-0000
EMISOR_EMAIL=facturacion@miempresa.com

# Backend principal
BACKEND_CALLBACK_URL=http://localhost:8000/dgii/callback
